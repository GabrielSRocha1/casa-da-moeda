# ============================================================
# Casa da Moeda Master Digital — SUPABASE
# Copie este arquivo para `.env` e preencha com os valores do
# seu projeto: Supabase → Project Settings → API
# ============================================================

# URL do projeto (ex.: https://abcdefghijklm.supabase.co)
SUPABASE_URL=

# Chave PÚBLICA (anon/publishable). É segura para o frontend —
# o que protege os dados é o RLS (Row Level Security) do banco.
SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# SOMENTE BACKEND / MIGRATIONS — NUNCA use no frontend!
# ------------------------------------------------------------

# Chave service_role (acesso total, ignora RLS). Apenas no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres do Supabase (para migrations / backend):
# Supabase → Project Settings → Database → Connection string (URI)
# Ex.: postgresql://postgres.abcdefghijklm:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
