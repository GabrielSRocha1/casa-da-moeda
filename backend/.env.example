# ------------------------------------------------------------
# Casa da Moeda Master Digital — variáveis de ambiente
# Copie para .env e ajuste. Nada aqui é obrigatório em desenvolvimento.
# ------------------------------------------------------------

NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Banco de dados
#  - Desenvolvimento (padrão): Postgres embutido via PGlite, persistido em disco:
DATABASE_URL=pglite://./data/pglite
#  - Em memória (some ao reiniciar):  DATABASE_URL=memory://
#  - Produção / Supabase:             DATABASE_URL=postgres://user:senha@host:5432/db
DATABASE_SSL=false

# Segurança
# Lista separada por vírgula. Use "*" apenas em desenvolvimento.
CORS_ORIGINS=*
# Segredo enviado pelo provedor de pagamento no header x-webhook-secret (mín. 16 caracteres).
WEBHOOK_SECRET=dev-webhook-secret-change-me
RATE_LIMIT_ENABLED=true
# Ative quando estiver atrás de proxy reverso (Caddy, Nginx, Cloudflare)
TRUST_PROXY=false

# Regras do P2P
P2P_FEE_BPS=150            # 1,5% de taxa
P2P_MIN_FIAT=20            # R$ mínimo por ordem
P2P_MAX_FIAT=50000         # R$ máximo por ordem
ORDER_TTL_MINUTES=15       # validade da cobrança Pix
AUTO_SETTLE=false          # true = ao confirmar PAID, já envia os tokens e conclui a ordem

# Carteiras aceitas para auto-custódia (Verum Wallet): solana, evm
WALLET_NETWORKS=solana,evm

# Pix simulado (substitua pelo provedor real em produção)
PIX_KEY=pix-sandbox@casadamoeda.dev
PIX_MERCHANT_NAME=CASA DA MOEDA MASTER
PIX_MERCHANT_CITY=SAO PAULO

# Feed de preços (ms entre atualizações). 0 desativa.
PRICE_FEED_INTERVAL_MS=15000
# live = preços e movimentação REAIS dos tokens na Solana (Jupiter/DexScreener + câmbio USD-BRL)
# simulated = passeio aleatório local (sem rede)
PRICE_FEED_MODE=live
# RPC pública da Solana (movimentação on-chain e supply). Troque por um endpoint
# dedicado (Helius, QuickNode, Triton…) se atingir rate limit.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ------------------------------------------------------------
# E-mail transacional (Zoho SMTP) — confirmação de e-mail.
# Use uma APP PASSWORD do Zoho (Security -> App Passwords), nunca a senha da conta.
# MAIL_FROM deve ser a conta autenticada (ou um alias dela).
# 465 = SSL direto (SMTP_SECURE=true) | 587 = STARTTLS (SMTP_SECURE=false)
# Sem SMTP_USER/SMTP_PASS em desenvolvimento, o código é escrito no log em vez de enviado.
# ------------------------------------------------------------
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Casa da Moeda Master Digital <no-reply@mastter.digital>

# ------------------------------------------------------------
# Twilio Verify — confirmação de telefone por SMS.
# Crie um Verify Service no console da Twilio e copie o SID (começa com VA...).
# Sem credenciais em desenvolvimento, o código é escrito no log em vez de enviado.
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Regras dos códigos de verificação
VERIFY_CODE_TTL_MINUTES=10          # validade do código
VERIFY_MAX_ATTEMPTS=5               # tentativas antes de exigir novo código
VERIFY_RESEND_COOLDOWN_SECONDS=60   # intervalo mínimo entre reenvios

# ------------------------------------------------------------
# Supabase (backend). Preencha quando migrar o banco para o Supabase.
#  - DATABASE_URL: use a connection string do Supabase (acima).
#  - service_role: NUNCA exponha no frontend.
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
