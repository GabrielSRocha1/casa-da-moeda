{
  "name": "cmmd-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Casa da Moeda Master Digital — site (HTML + Tailwind compilado + JavaScript nativo)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:env": "node scripts/env.mjs",
    "serve": "node scripts/serve.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/app.css --watch",
    "test": "python3 tests/test_site.py && python3 tests/test_parceria.py"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
